{
  "name": "pritonn-desktop",
  "private": true,
  "version": "5.17.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:start": "electron .",
    "electron:dev": "concurrently -k \"vite\" \"electron .\"",
    "electron:pack": "tsc -b && vite build && electron-builder --dir",
    "electron:build": "tsc -b && vite build && electron-builder --win",
    "cap:sync": "tsc -b && vite build && npx cap sync",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.90.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "build": {
    "appId": "com.pritonn.desktop",
    "productName": "PRITONN",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "PRITONN"
    }
  }
}
